generator client {
  provider      = "prisma-client-js"
  // ویندوز برای توسعه؛ rhel برای Netlify/Vercel، debian برای Docker (node:slim)
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // آدرس pooler سوپابیس (برای برنامه)
  directUrl = env("DIRECT_URL") // آدرس مستقیم (برای مایگریشن)
}

model User {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String
}

// تنظیمات شرکت (فقط یک ردیف با id=1)
model Setting {
  id          Int     @id
  companyName String
  subtitle    String  @default("") // خط زیر نام شرکت (مثلاً انواع محصولات)
  address     String
  phone       String
  mobile      String  @default("")
  managerName String  @default("") // اسم زیر «امضا مدیریت»
  footerNote  String
  logo        String? // data URL
}

model Product {
  id         Int      @id @default(autoincrement())
  name       String
  price      Float    @default(0) // ریال، قیمت پیش‌فرض هر کیلو
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  items      InvoiceItem[]
}

model Customer {
  id       Int       @id @default(autoincrement())
  name     String
  phone    String    @default("")
  address  String    @default("")
  invoices Invoice[]
}

model InvoiceCounter {
  year Int @id
  last Int
}

model Invoice {
  id             Int           @id @default(autoincrement())
  year           Int // سال شمسی
  number         Int
  date           DateTime
  customerId     Int
  customer       Customer      @relation(fields: [customerId], references: [id])
  expenseTitle   String        @default("هزینه")
  expenseAmount  Float         @default(0)
  createdAt      DateTime      @default(now())
  items          InvoiceItem[]

  @@unique([year, number])
}

model InvoiceItem {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  date        DateTime // تاریخ فروش همین ردیف
  havaleNo    String   @default("") // شماره حواله (دستی)
  productName String   // متن چاپ‌شده زیر «نوع چله»؛ می‌تواند متن دلخواه باشد
  weight      Float?
  fee         Float?
  amount      Float    @default(0) // مبلغ کل ردیف (وزن×فی یا دستی)
}
