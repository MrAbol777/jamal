# تنظیمات سرور برنامه‌ی جمال
# این فایل فقط نمونه است. install.sh فایل واقعی deploy/.env را با رمزهای تصادفی می‌سازد.
# فایل واقعی را هرگز در گیت قرار ندهید و برای کسی نفرستید.

# ---------- دامنه ----------
# دامنه‌ی سایت (مثلاً example.ir). خالی = اجرای ساده با IP و http
DOMAIN=
# آدرسی که Caddy به آن جواب می‌دهد: همان دامنه، یا «:80» وقتی دامنه ندارید
SITE_ADDRESS=:80
# با HTTPS (دامنه) = 1   ؛   با http و IP = 0
COOKIE_SECURE=0

# ---------- رمزها (install.sh خودکار می‌سازد؛ بعد از راه‌اندازی تغییر ندهید) ----------
# رمز دیتابیس. اگر بعد از ساخت دیتابیس عوض شود، برنامه دیگر به دیتابیس وصل نمی‌شود.
DB_PASSWORD=
# کلید امضای نشست ورود (طولانی و تصادفی). تغییرش همه را از حساب خارج می‌کند.
SESSION_SECRET=

# ---------- میرورها (برای سرورهای ایران؛ خالی = آدرس اصلی) ----------
# پیشوند نام ایمیج‌های داکر، اگر Docker Hub بسته است. نمونه‌ها:
#   IMAGE_PREFIX=docker.arvancloud.ir/
#   IMAGE_PREFIX=docker.arvancloud.ir/library/
# حتماً با «/» تمام شود. اگر registry-mirrors در /etc/docker/daemon.json کار می‌کند، خالی بگذارید.
IMAGE_PREFIX=
# میرور npm برای ساخت برنامه (مثلاً https://registry.npmmirror.com)
NPM_REGISTRY=
# میرور فایل‌های Prisma (مثلاً https://registry.npmmirror.com/-/binary/prisma)
PRISMA_ENGINES_MIRROR=
# میرور Debian برای نصب Chromium داخل ایمیج (مثلاً http://mirror.arvancloud.ir/debian)
DEBIAN_MIRROR=

# ---------- سایر ----------
# محل نگهداری داده‌ها روی سرور (دیتابیس و گواهی‌ها). تغییر ندهید.
DATA_DIR=/var/lib/jamal
# منطقه‌ی زمانی برنامه
APP_TZ=Asia/Tehran
